{
    "editor.rulers": [
        80,
        120
    ],
    "files.exclude": {
        // "**/*.pyc": true,
        "**/*pycache*": true,
        ".devcontainer": true,
        ".github": true,
        "docs": true,
        "venv": true,
        "covpp.egg-info": true,
        "dist": true,
        "LICENSE": true,
        // "pyproject.toml": true,
        "setup.py": true,
    },
    // exclude from search
    "search.exclude": {
        "docs/": true,
        "**/*.drawio": true,
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8",
        "editor.formatOnSave": true,
    },
    "autopep8.args": [
        "--max-line-length=140",
        "--ignore=E501"
    ],
    "flake8.enabled": false,
    "flake8.args": [
        "--max-line-length=140"
    ],
    "pylint.args": [
        // "enable=false",
        "--max-line-length=140",
        "--ignore-long-lines=^\\s*#.*$",
        "--disable=E1101", // disable no-member error
        // "--disable=C0114",
        // "--disable=C0301",
        // "--disable=C0115",
        // "--disable=C0116",
        // "--disable=W1514",
        // "--disable=E1121"
    ],
    "python.pipenvPath": "/home/morteza/Documents/00-CovPP/covpp/venv",
    "python.autoComplete.extraPaths": [
        "/home/morteza/mo_ws/devel/lib/python3/dist-packages",
        "/home/morteza/catkin_ws/devel/lib/python3/dist-packages",
        "/opt/ros/noetic/lib/python3/dist-packages"
    ],
    "python.analysis.extraPaths": [
        "/home/morteza/mo_ws/devel/lib/python3/dist-packages",
        "/home/morteza/catkin_ws/devel/lib/python3/dist-packages",
        "/opt/ros/noetic/lib/python3/dist-packages"
    ],
    // "terminal.integrated.defaultProfile.linux": "Login Bash",
    "terminal.integrated.defaultProfile.linux": "zsh",
    // 
    "latex-workshop.bibtex-fields.sort.enabled": true,
    "latex-workshop.bibtex-format.sort.enabled": true,
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.formatting.latexindent.args": [
        "-c",
        "%DIR%/",
        "%TMPFILE%",
        "-y=defaultIndent: '%INDENT%'",
        "-m",
        "-l"
    ],
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.view.pdf.viewer": "tab"
}